      "$type": "dimension",
      "$value": "{ref.spacing-3}",
      "$description": "Tick row sits 3px below the track in the kit"
    },
    "track": {
      "$type": "color",
      "$value": "{semantic.control-track}"
    },
    "track-disabled": {
      "$type": "color",
      "$value": "{semantic.control-disabled}",
      "$description": "unverified. Approximates the kit disabled unfilled track"
    },
    "track-shadow": {
      "$type": "shadow",
      "$value": "{semantic.shadow-switch-track}"
    },
    "range": {
      "$type": "color",
      "$value": "{semantic.accent}"
    },
    "range-disabled": {
      "$type": "color",
      "$value": "{semantic.accent-disabled}",
      "$description": "Kit disabled filled track sits at ~accent 25%"
    },
    "thumb-bg": {
      "$type": "color",
      "$value": "{semantic.slider-knob}"
    },
    "thumb-shadow": {
      "$type": "shadow",
      "$value": "{semantic.shadow-switch-thumb}"
    },
    "tick": {
      "$type": "color",
      "$value": "{semantic.label-tertiary}"
    },
    "tick-disabled": {
      "$type": "color",
      "$value": "{semantic.label-quaternary}"
    }
