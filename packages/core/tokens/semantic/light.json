{
  "semantic": {
    "$type": "color",
    "label": { "$value": "{ref.black-847}" },
    "label-secondary": { "$value": "{ref.black-498}" },
    "label-tertiary": { "$value": "{ref.black-260}" },
    "label-quaternary": { "$value": "{ref.black-130}" },
    "window-bg": { "$value": "#F6F6F6" },
    "control-bg": { "$value": "#FFFFFF" },
    "content-bg": { "$value": "#FFFFFF" },
    "under-page-bg": { "$value": "#E8E8E8", "$description": "unverified" },
    "accent": { "$value": "{ref.blue}" },
    "accent-hover": { "$value": "color-mix(in oklab, var(--macvue-accent), black 6%)" },
    "accent-pressed": { "$value": "color-mix(in oklab, var(--macvue-accent), black 12%)" },
    "focus-ring": { "$value": "color-mix(in srgb, var(--macvue-accent), transparent 50%)" },
    "selection-bg": { "$value": "{semantic.accent}" },
    "selection-bg-unfocused": { "$value": "{ref.black-100}", "$description": "unverified" },
    "separator": { "$value": "{ref.black-100}" },
    "border-control": { "$value": "{ref.black-130}", "$description": "unverified" },
    "material-sidebar-bg": { "$value": "rgb(255 255 255 / 0.7)" },
    "material-sidebar-blur": { "$type": "dimension", "$value": "{ref.blur-20}" },
    "material-popover-bg": { "$value": "rgb(255 255 255 / 0.8)", "$description": "unverified" },
    "material-popover-blur": { "$type": "dimension", "$value": "{ref.blur-24}" },
    "material-hud-bg": { "$value": "rgb(0 0 0 / 0.65)" },
    "shadow-window": {
      "$type": "shadow",
      "$value": "0 10px 30px rgb(0 0 0 / 0.2), 0 0 1px rgb(0 0 0 / 0.15)",
      "$description": "unverified"
    },
    "shadow-popover": {
      "$type": "shadow",
      "$value": "0 4px 16px rgb(0 0 0 / 0.2), 0 0 1px rgb(0 0 0 / 0.2)",
      "$description": "unverified"
    },
    "shadow-menu": {
      "$type": "shadow",
      "$value": "0 5px 20px rgb(0 0 0 / 0.2), 0 0 1px rgb(0 0 0 / 0.2)",
      "$description": "unverified"
    }
  }
}
